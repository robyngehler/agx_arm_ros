# Run a named activity graph end to end (the coordinator's public entry point).
#
# Repo-owned, agx_arm-centric. The coordinator loads the named activity graph
# (YAML-backed for the MVP), validates it, then schedules and dispatches each
# node as a PerformAction through its internal performer, enforcing resource
# tokens and sync-flag barrier groups.

# --- Goal ---
string activity_id        # e.g. hefeweizen_pour_v1
string metadata_json      # optional run-time overrides as a JSON object; may be empty
                          #
                          # {"playback": {...}} replays every recorded action in
                          # this run under those settings, merged over whatever
                          # each action declares in the catalogue. Same keys as
                          # PerformAction's "playback"; the catalogue is left
                          # unchanged, so the next run is unaffected. Example:
                          #   {"playback": {"mode": "tempo_scale",
                          #                 "speed_scale": 0.6}}
                          #
                          # {"resume": {"from_step": N}} starts the run at
                          # operator step N (1-based) and marks the earlier steps
                          # completed. A step is one dispatch batch, so a
                          # synchronized pair is one step and is never entered
                          # half way. Refused when step N replays a taught path:
                          # a replay commands taught joint angles from wherever
                          # the arm stands. The refusal names the nearest earlier
                          # step that plans its own approach.
---
# --- Result ---
bool success
string message
int32 completed_nodes
int32 total_nodes
string failed_action_id   # empty on success; the catalogue action that aborted the run
---
# --- Feedback ---
int32 action_no           # most recent node that changed state
string action_id
string state              # running | completed | failed
int32 completed_nodes
int32 total_nodes
