<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nero">
  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/nero/urdf/nero_description.urdf"/>

  <link name="omnihand_flange">
    <inertial>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1.0e-05" ixy="0" ixz="0" iyy="1.0e-05" iyz="0" izz="1.0e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.012"/>
      </geometry>
      <material name="omnihand_flange_grey">
        <color rgba="0.65 0.65 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.006" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.012"/>
      </geometry>
    </collision>
  </link>

  <joint name="omnihand_flange_joint" type="fixed">
    <origin xyz="0.032 0 -0.0235" rpy="-1.5708 0 -1.5708"/>
    <parent link="link7"/>
    <child link="omnihand_flange"/>
  </joint>
</robot>