<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="omnihand">
  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/omnihand/urdf/xacro/hand.xacro" />

  <link name="right_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <xacro:hand name="right" mirror="1">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:hand>
</robot>