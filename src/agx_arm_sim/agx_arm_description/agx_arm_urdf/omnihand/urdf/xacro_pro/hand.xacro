<?xml version="1.0"?>
<!--
  OmniHand Pro 2025 (O12, 12 active DoF) hand macro.

  Adapted from the official vendor description
  (AgibotTech omnihand_pro_description, o12_hand_description-o12_t3) under Mulan PSL v2.
  Vendor link frames, limits, meshes, and mimic ratios are kept verbatim; only the
  repo-integration seam is changed so it drops into the existing OmniHand mount:

    - macro contract matches the legacy O10 macro: `hand name mirror *origin`,
      with the palm parented to `${name}_base_link` (callers create that link off
      the omnihand_flange) and the `*origin` block as the base_link -> palm offset.
    - `mirror_mesh` (vendor left/right mesh + thumb-roll-rpy switch) is derived from
      `mirror` here (mirror == -1 => left), so existing callers that pass only
      `name`/`mirror` are unchanged.
    - mesh_path and includes point at this package.

  Active joints (12): thumb_roll, thumb_abad, thumb_mcp, thumb_pip, index_abad,
  index_mcp, index_pip, middle_abad, middle_mcp, middle_pip, ring_mcp, pinky_mcp.
  The remaining finger joints are vendor `mimic` joints (underactuated coupling).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/omnihand/urdf/xacro_pro/const.xacro" />
  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/omnihand/urdf/xacro_pro/material.xacro" />
  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/omnihand/urdf/xacro_pro/thumb.xacro" />
  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/omnihand/urdf/xacro_pro/index.xacro" />
  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/omnihand/urdf/xacro_pro/middle.xacro" />
  <xacro:include filename="$(find agx_arm_description)/agx_arm_urdf/omnihand/urdf/xacro_pro/ring_pinky.xacro" />
  <xacro:property name="mesh_path" value="package://agx_arm_description/agx_arm_urdf/omnihand/meshes_pro" />

  <xacro:macro name="hand" params="name mirror *origin">

    <!-- vendor mirror_mesh switch: left hand (mirror == -1) uses the l_* meshes
         and the extra thumb-roll rpy offset; right hand uses the r_* meshes. -->
    <xacro:property name="mirror_mesh" value="${mirror == -1}" />

    <joint name="${name}_palm_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${name}_base_link" />
      <child link="${name}_palm" />
    </joint>

    <link name="${name}_palm">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <xacro:if value="${mirror_mesh == True}">
            <mesh filename="${mesh_path}/l_palm.STL" />
          </xacro:if>
          <xacro:if value="${mirror_mesh == False}">
            <mesh filename="${mesh_path}/r_palm.STL" />
          </xacro:if>
        </geometry>
        <material name="black" />
      </visual>
      <inertial>
        <origin rpy="0 0 0" xyz="${palm_com_x} ${palm_com_y*mirror} ${palm_com_z}" />
        <mass value="${palm_mass}" />
        <inertia
          ixx="${palm_ixx}" ixy="${palm_ixy*mirror}" ixz="${palm_ixz}"
          iyy="${palm_iyy}" iyz="${palm_iyz*mirror}" izz="${palm_izz}" />
      </inertial>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 ${palm_collision_cylinder_z}" />
        <geometry>
          <cylinder radius="${palm_collision_cylinder_r}" length="${palm_collision_cylinder_l}" />
        </geometry>
      </collision>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 ${palm_collision_box_z}" />
        <geometry>
          <box size="${palm_collision_box_l} ${palm_collision_box_w} ${palm_collision_box_h}" />
        </geometry>
      </collision>
    </link>

    <xacro:thumb name="${name}" mirror="${mirror}" mirror_mesh="${mirror_mesh}">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:thumb>

    <xacro:index name="${name}" mirror="${mirror}" mirror_mesh="${mirror_mesh}">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:index>

    <xacro:middle name="${name}" mirror="${mirror}" mirror_mesh="${mirror_mesh}">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:middle>

    <joint name="${name}_ring_mcp_joint" type="revolute">
      <origin xyz="${ring_mcp_x} ${ring_mcp_y*mirror} ${ring_mcp_z}" rpy="0.0 0.0 0.0" />
      <parent link="${name}_palm" />
      <child link="${name}_ring_mcp_link" />
      <axis xyz="0 1 0" />
      <limit effort="${ring_mcp_torque_max}" velocity="${ring_mcp_velocity_max}"
        lower="${ring_mcp_position_min}" upper="${ring_mcp_position_max}" />
    </joint>
    <xacro:ring name="${name}_ring" mirror="${mirror}" mirror_mesh="${mirror_mesh}">
    </xacro:ring>

    <joint name="${name}_pinky_mcp_joint" type="revolute">
      <origin xyz="${pinky_mcp_x} ${pinky_mcp_y*mirror} ${pinky_mcp_z}" rpy="0.0 0.0 0.0" />
      <parent link="${name}_palm" />
      <child link="${name}_pinky_mcp_link" />
      <axis xyz="0 1 0" />
      <limit effort="${ring_mcp_torque_max}" velocity="${ring_mcp_velocity_max}"
        lower="${ring_mcp_position_min}" upper="${ring_mcp_position_max}" />
    </joint>
    <xacro:ring name="${name}_pinky" mirror="${mirror}" mirror_mesh="${mirror_mesh}">
    </xacro:ring>

  </xacro:macro>
</robot>
