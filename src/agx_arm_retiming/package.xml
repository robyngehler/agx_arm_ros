<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agx_arm_retiming</name>
  <version>0.1.0</version>
  <description>
    Time parameterization for recorded agx_arm trajectories. Wraps MoveIt's
    time-optimal path parameterization (TOTG) for the Python runtime, which
    cannot reach it otherwise, and carries the mode layer that decides whether a
    recording keeps its taught timing or is re-timed.
  </description>
  <maintainer email="robyn.gehler00@gmail.com">Robyn Gehler</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>moveit_core</depend>
  <depend>pybind11_vendor</depend>
  <depend>eigen</depend>

  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
