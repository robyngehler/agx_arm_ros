<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_name)">
  <xacro:arg name="robot_name" default="agx_arm" />
  <xacro:arg name="arm_type" default="nero" />
  <xacro:arg name="effector_type" default="none" />
  <xacro:arg name="revo2_type" default="left" />
  <xacro:arg name="omnihand_type" default="left" />
  <xacro:arg name="planning_group_name" default="nero_arm" />
  <xacro:arg name="arm_base_frame" default="base_link" />
  <xacro:arg name="arm_tip_frame" default="tcp_link" />
  <xacro:arg name="end_effector_parent_link" default="tcp_link" />
  <xacro:arg name="mount_body_link" default="" />
  <xacro:arg name="arm_joint_prefix" default="" />
  <xacro:arg name="arm_link_prefix" default="" />
  <xacro:arg name="include_end_effector_groups" default="true" />
  <xacro:arg name="include_dual_arm_groups" default="false" />
  <!-- Per-side OmniHand instantiation for the dual-arm slice (duo_hand profile);
       ignored unless include_dual_arm_groups is true. -->
  <xacro:arg name="include_left_omnihand" default="false" />
  <xacro:arg name="include_right_omnihand" default="false" />
  <xacro:arg name="left_arm_base_frame" default="left_arm_base_link" />
  <xacro:arg name="left_arm_tip_frame" default="left_arm_nero_tool0" />
  <xacro:arg name="left_mount_body_link" default="" />
  <xacro:arg name="left_arm_joint_prefix" default="left_arm_" />
  <xacro:arg name="left_arm_link_prefix" default="left_arm_" />
  <xacro:arg name="right_arm_base_frame" default="right_arm_base_link" />
  <xacro:arg name="right_arm_tip_frame" default="right_arm_nero_tool0" />
  <xacro:arg name="right_mount_body_link" default="" />
  <xacro:arg name="right_arm_joint_prefix" default="right_arm_" />
  <xacro:arg name="right_arm_link_prefix" default="right_arm_" />

  <xacro:property name="arm_type" value="$(arg arm_type)" />
  <xacro:property name="effector_type" value="$(arg effector_type)" />
  <xacro:property name="revo2_type" value="$(arg revo2_type)" />
  <xacro:property name="omnihand_type" value="$(arg omnihand_type)" />
  <xacro:property name="include_end_effector_groups" value="$(arg include_end_effector_groups)" />
  <xacro:property name="flange_link" value="${arm_link_prefix}link7" />
  <xacro:property name="planning_group_name" value="$(arg planning_group_name)" />
  <xacro:property name="arm_base_frame" value="$(arg arm_base_frame)" />
  <xacro:property name="arm_tip_frame" value="$(arg arm_tip_frame)" />
  <xacro:property name="end_effector_parent_link" value="$(arg end_effector_parent_link)" />
  <xacro:property name="mount_body_link" value="$(arg mount_body_link)" />
  <xacro:property name="arm_joint_prefix" value="$(arg arm_joint_prefix)" />
  <xacro:property name="arm_link_prefix" value="$(arg arm_link_prefix)" />
  <xacro:property name="include_dual_arm_groups" value="$(arg include_dual_arm_groups)" />
  <xacro:property name="include_left_omnihand" value="$(arg include_left_omnihand)" />
  <xacro:property name="include_right_omnihand" value="$(arg include_right_omnihand)" />
  <xacro:property name="left_arm_base_frame" value="$(arg left_arm_base_frame)" />
  <xacro:property name="left_arm_tip_frame" value="$(arg left_arm_tip_frame)" />
  <xacro:property name="left_mount_body_link" value="$(arg left_mount_body_link)" />
  <xacro:property name="left_arm_joint_prefix" value="$(arg left_arm_joint_prefix)" />
  <xacro:property name="left_arm_link_prefix" value="$(arg left_arm_link_prefix)" />
  <xacro:property name="right_arm_base_frame" value="$(arg right_arm_base_frame)" />
  <xacro:property name="right_arm_tip_frame" value="$(arg right_arm_tip_frame)" />
  <xacro:property name="right_mount_body_link" value="$(arg right_mount_body_link)" />
  <xacro:property name="right_arm_joint_prefix" value="$(arg right_arm_joint_prefix)" />
  <xacro:property name="right_arm_link_prefix" value="$(arg right_arm_link_prefix)" />

  <xacro:macro name="arm_chain_group" params="group_name base_frame tip_frame">
    <group name="${group_name}">
      <chain base_link="${base_frame}" tip_link="${tip_frame}" />
    </group>
  </xacro:macro>

  <xacro:macro name="nero_arm_home_state" params="group_name joint_prefix">
    <group_state name="home" group="${group_name}">
      <joint name="${joint_prefix}joint1" value="0" />
      <joint name="${joint_prefix}joint2" value="0" />
      <joint name="${joint_prefix}joint3" value="0" />
      <joint name="${joint_prefix}joint4" value="0" />
      <joint name="${joint_prefix}joint5" value="0" />
      <joint name="${joint_prefix}joint6" value="0" />
      <joint name="${joint_prefix}joint7" value="0" />
    </group_state>
  </xacro:macro>

  <xacro:macro name="nero_arm_disable_collisions" params="link_prefix mount_body_link">
    <disable_collisions link1="${link_prefix}base_link" link2="${link_prefix}link1" reason="Adjacent" />
    <disable_collisions link1="${link_prefix}link1" link2="${link_prefix}link2" reason="Adjacent" />
    <disable_collisions link1="${link_prefix}link2" link2="${link_prefix}link3" reason="Adjacent" />
    <disable_collisions link1="${link_prefix}link3" link2="${link_prefix}link4" reason="Adjacent" />
    <disable_collisions link1="${link_prefix}link4" link2="${link_prefix}link5" reason="Adjacent" />
    <disable_collisions link1="${link_prefix}link5" link2="${link_prefix}link6" reason="Adjacent" />
    <disable_collisions link1="${link_prefix}link6" link2="${link_prefix}link7" reason="Adjacent" />
    <xacro:if value="${mount_body_link != ''}">
      <disable_collisions link1="${mount_body_link}" link2="${link_prefix}base_link" reason="Adjacent" />
      <disable_collisions link1="${mount_body_link}" link2="${link_prefix}link1" reason="Adjacent" />
      <!-- link2 rotates about the mount, so it sweeps along the torso hull by
           construction: over the whole j1 x j2 range it never gets further than
           12.9 mm (left) / 13.3 mm (right) from the body, median 7.2 / 8.0 mm.
           A check on a pair that is always within 13 mm and touches at 0.01 mm
           on a pose an operator back-drove the arm into by hand yields refusals,
           not safety. Measured 2026-08-27, docs/control/bringups/tea_demo.md. -->
      <disable_collisions link1="${mount_body_link}" link2="${link_prefix}link2" reason="Never" />
    </xacro:if>
  </xacro:macro>

  <!-- Per-side instantiable: the single-side profiles keep the legacy defaults
       (group "hand", the file-level planning group / parent link / link prefix),
       while the dual-arm slice instantiates it once per side with explicit
       group_name/parent_group/parent_link/link_prefix so the two hands do not
       collide on the MoveIt group name. -->
  <xacro:macro name="omnihand_group" params="side group_name:='hand' parent_group:='' parent_link:='' link_prefix:=''">
    <xacro:property name="resolved_parent_group" value="${parent_group if parent_group != '' else planning_group_name}" />
    <xacro:property name="resolved_parent_link" value="${parent_link if parent_link != '' else end_effector_parent_link}" />
    <xacro:property name="resolved_link_prefix" value="${link_prefix if link_prefix != '' else arm_link_prefix}" />
    <group name="${group_name}">
      <joint name="${side}_thumb_roll_joint" />
      <joint name="${side}_thumb_abad_joint" />
      <joint name="${side}_thumb_mcp_joint" />
      <joint name="${side}_thumb_pip_joint" />
      <joint name="${side}_index_abad_joint" />
      <joint name="${side}_index_mcp_joint" />
      <joint name="${side}_index_pip_joint" />
      <joint name="${side}_middle_abad_joint" />
      <joint name="${side}_middle_mcp_joint" />
      <joint name="${side}_middle_pip_joint" />
      <joint name="${side}_ring_mcp_joint" />
      <joint name="${side}_pinky_mcp_joint" />
    </group>
    <end_effector name="${side}_omnihand_eef" parent_link="${resolved_parent_link}" group="${group_name}" parent_group="${resolved_parent_group}" />
    <group_state name="hand_open" group="${group_name}">
      <joint name="${side}_thumb_roll_joint" value="0.0" />
      <joint name="${side}_thumb_abad_joint" value="0.0" />
      <joint name="${side}_thumb_mcp_joint" value="0.0" />
      <joint name="${side}_thumb_pip_joint" value="0.0" />
      <joint name="${side}_index_abad_joint" value="0.0" />
      <joint name="${side}_index_mcp_joint" value="0.0" />
      <joint name="${side}_index_pip_joint" value="0.0" />
      <joint name="${side}_middle_abad_joint" value="0.0" />
      <joint name="${side}_middle_mcp_joint" value="0.0" />
      <joint name="${side}_middle_pip_joint" value="0.0" />
      <joint name="${side}_ring_mcp_joint" value="0.0" />
      <joint name="${side}_pinky_mcp_joint" value="0.0" />
    </group_state>
    <group_state name="hand_half_close" group="${group_name}">
      <joint name="${side}_thumb_roll_joint" value="${-0.2 if side == 'left' else 0.2}" />
      <joint name="${side}_thumb_abad_joint" value="${0.3 if side == 'left' else -0.3}" />
      <joint name="${side}_thumb_mcp_joint" value="-0.25" />
      <joint name="${side}_thumb_pip_joint" value="-0.3" />
      <joint name="${side}_index_abad_joint" value="0.0" />
      <joint name="${side}_index_mcp_joint" value="0.6" />
      <joint name="${side}_index_pip_joint" value="0.6" />
      <joint name="${side}_middle_abad_joint" value="0.0" />
      <joint name="${side}_middle_mcp_joint" value="0.6" />
      <joint name="${side}_middle_pip_joint" value="0.6" />
      <joint name="${side}_ring_mcp_joint" value="0.6" />
      <joint name="${side}_pinky_mcp_joint" value="0.6" />
    </group_state>
    <group_state name="hand_close" group="${group_name}">
      <joint name="${side}_thumb_roll_joint" value="${-0.4 if side == 'left' else 0.4}" />
      <joint name="${side}_thumb_abad_joint" value="${0.5 if side == 'left' else -0.5}" />
      <joint name="${side}_thumb_mcp_joint" value="-0.5" />
      <joint name="${side}_thumb_pip_joint" value="-0.6" />
      <joint name="${side}_index_abad_joint" value="0.0" />
      <joint name="${side}_index_mcp_joint" value="1.1" />
      <joint name="${side}_index_pip_joint" value="1.1" />
      <joint name="${side}_middle_abad_joint" value="0.0" />
      <joint name="${side}_middle_mcp_joint" value="1.1" />
      <joint name="${side}_middle_pip_joint" value="1.1" />
      <joint name="${side}_ring_mcp_joint" value="1.2" />
      <joint name="${side}_pinky_mcp_joint" value="1.2" />
    </group_state>
    <passive_joint name="${side}_thumb_dip_joint" />
    <passive_joint name="${side}_index_dip_joint" />
    <passive_joint name="${side}_middle_dip_joint" />
    <passive_joint name="${side}_ring_pip_joint" />
    <passive_joint name="${side}_ring_dip_joint" />
    <passive_joint name="${side}_pinky_pip_joint" />
    <passive_joint name="${side}_pinky_dip_joint" />
    <!-- link7, the flange, the hand base and the palm are joined by fixed joints,
         so their relative pose is constant and a check between them returns the
         same answer in every state. link6 is across joint7 and does vary. -->
    <disable_collisions link1="${resolved_link_prefix}link7" link2="${resolved_link_prefix}omnihand_flange" reason="Adjacent" />
    <disable_collisions link1="${resolved_link_prefix}link7" link2="${side}_base_link" reason="Adjacent" />
    <disable_collisions link1="${resolved_link_prefix}link7" link2="${side}_palm" reason="Adjacent" />
    <disable_collisions link1="${resolved_link_prefix}omnihand_flange" link2="${side}_base_link" reason="Adjacent" />
    <disable_collisions link1="${resolved_link_prefix}omnihand_flange" link2="${side}_palm" reason="Adjacent" />
    <!-- The hand sits in the wrist envelope and barely moves relative to it:
         swept over the whole joint5-joint7 range the closest approach is 2.8 mm
         (link5/flange) to 17 mm (link6/palm), and the joint limits leave no
         configuration that closes it. Hand against the upper arm and the body
         stays ACTIVE - that is the pairing a plan can actually drive into. -->
    <disable_collisions link1="${resolved_link_prefix}link6" link2="${resolved_link_prefix}omnihand_flange" reason="Never" />
    <disable_collisions link1="${resolved_link_prefix}link6" link2="${side}_base_link" reason="Never" />
    <disable_collisions link1="${resolved_link_prefix}link6" link2="${side}_palm" reason="Never" />
    <disable_collisions link1="${resolved_link_prefix}link5" link2="${resolved_link_prefix}omnihand_flange" reason="Never" />
    <disable_collisions link1="${resolved_link_prefix}link5" link2="${side}_palm" reason="Never" />
    <!-- Disable ALL intra-hand collision pairs. The hand joints are never planned
         by the arm groups (their values come from hardware readback), self-contact
         in a grasp is intended (fist: fingertips touch the palm, thumb presses the
         fingers, middle/ring rub), and the vendor meshes + approximate mimic
         coupling interpenetrate at legitimate poses anyway - so intra-hand FCL
         checks only invalidate arm-planning start states (OMPL: 'invalid start
         state' after a fist). Hand-vs-upper-arm and hand-vs-body pairs stay ACTIVE.
         Generated: all pairs over the hand link set, including currently
         collision-less links (thumb_roll/index_abad/middle_abad) for robustness. -->
    <disable_collisions link1="${side}_base_link" link2="${side}_palm" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_thumb_roll_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_thumb_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_thumb_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_thumb_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_thumb_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_thumb_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_index_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_index_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_index_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_index_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_index_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_middle_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_middle_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_middle_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_middle_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_middle_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_ring_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_ring_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_ring_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_ring_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_pinky_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_pinky_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_pinky_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_base_link" link2="${side}_pinky_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_thumb_roll_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_thumb_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_thumb_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_thumb_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_thumb_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_thumb_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_index_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_index_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_index_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_index_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_index_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_middle_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_middle_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_middle_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_middle_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_middle_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_ring_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_ring_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_ring_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_ring_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_pinky_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_pinky_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_pinky_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_palm" link2="${side}_pinky_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_thumb_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_thumb_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_thumb_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_thumb_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_thumb_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_index_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_index_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_index_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_index_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_index_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_middle_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_middle_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_middle_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_middle_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_middle_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_ring_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_ring_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_ring_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_ring_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_pinky_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_pinky_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_pinky_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_roll_link" link2="${side}_pinky_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_thumb_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_thumb_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_thumb_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_thumb_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_index_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_index_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_index_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_index_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_index_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_middle_abad_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_middle_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_middle_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_middle_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_middle_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_ring_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_ring_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_ring_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_ring_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_pinky_mcp_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_pinky_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_pinky_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_abad_link" link2="${side}_pinky_tip" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_mcp_link" link2="${side}_thumb_pip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_mcp_link" link2="${side}_thumb_dip_link" reason="IntraHand" />
    <disable_collisions link1="${side}_thumb_mcp_link" link2="${side}_thumb_tip" reason="IntraHand" />
